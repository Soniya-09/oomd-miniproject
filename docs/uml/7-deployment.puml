@startuml 7-deployment
!include _style.iuml
title EduFlow — Deployment Diagram

node "User Device\n(PC / Mobile)" <<device>> {
  node "Web Browser" as Browser <<execution environment>> {
    artifact "HTML pages"
    artifact "JavaScript & CSS"
  }
}

node "CDN" <<external>> {
  artifact "Bootstrap 5\nChart.js 4" as Libs
}

node "Web Server (XAMPP / Linux)" <<device>> {
  node "Apache Web Server" as Apache <<execution environment>> {
    folder "public/" {
      artifact "index.php"
    }
  }
  node "PHP 8 Runtime" as PHP <<execution environment>> {
    artifact "EduFlow Application" as App
    artifact ".env config" as Env
  }
  node "Task Scheduler" <<execution environment>> {
    artifact "reminders.php" as Cron
  }
  folder "storage/" {
    artifact "Uploaded files" as Files
    artifact "Logs" as Logs
  }
}

node "Database Server" <<device>> {
  node "MySQL 8" <<execution environment>> {
    database "eduflow" as DB
  }
}

node "Mail Server" <<external>> as Mail

Browser --> Apache : HTTPS
Browser --> Libs : HTTPS
Apache --> PHP
App --> DB : TCP 3306
App --> Files
App --> Logs
Cron --> App
App --> Mail : SMTP\n(password reset)
@enduml
