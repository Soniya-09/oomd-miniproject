@startuml 2-class
!include _style.iuml
title EduFlow — Class Diagram
hide empty members

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  GRADED
  RETURNED
  RESUBMITTED
}

class Institution {
  - name: string
  - timezone: string
}

abstract class User {
  - id: int
  - fullName: string
  - email: string
  - passwordHash: string
  - role: Role
  - isActive: bool
  + login(email, password): bool
  + logout(): void
  + changePassword(old, new): void
}

class Admin {
  + createUser(data): User
  + deactivateUser(u: User): void
  + enroll(s: Student, c: Class): void
}

class Teacher {
  - employeeNo: string
  - designation: string
  + createAssignment(data): Assignment
  + grade(s: Submission, marks, feedback): void
  + returnForRevision(s: Submission, feedback): void
}

class Student {
  - admissionNo: string
  - rollNo: string
  + submit(a: Assignment, files): Submission
  + addTask(title, dueDate): PersonalTask
}

class AcademicSession {
  - name: string
  - startsOn: Date
  - endsOn: Date
}

class Class {
  - name: string
  - division: string
  + students(): Student[]
}

class Subject {
  - code: string
  - name: string
}

class Assignment {
  - title: string
  - description: string
  - dueAt: DateTime
  - maxMarks: decimal
  - allowLate: bool
  - status: string
  + publish(): void
  + close(): void
  + isOverdue(): bool
}

class Submission {
  - attempt: int
  - submittedAt: DateTime
  - isLate: bool
  - marks: decimal
  - status: SubmissionStatus
  + resubmit(files): void
}

class SubmissionFile {
  - fileName: string
  - sizeBytes: int
}

class Feedback {
  - comment: string
  - createdAt: DateTime
}

class PersonalTask {
  - title: string
  - priority: string
  - dueAt: DateTime
  - status: string
  - completedAt: DateTime
  + complete(): void
  + reopen(): void
}

class TaskCategory {
  - name: string
  - color: string
}

class Notification {
  - title: string
  - message: string
  - readAt: DateTime
  + markRead(): void
}

class Announcement {
  - title: string
  - body: string
  - publishedAt: DateTime
}

User <|-- Admin
User <|-- Teacher
User <|-- Student
User ..> Role

Institution "1" *-- "*" User
Institution "1" *-- "*" AcademicSession
AcademicSession "1" *-- "*" Class
Class "*" -- "*" Student : enrolled in >
Class "*" -- "*" Subject : taught >
Teacher "*" -- "*" Subject : teaches >

Teacher "1" -- "*" Assignment : creates >
Assignment "*" --> "1" Class
Assignment "*" --> "1" Subject
Assignment "1" *-- "*" Submission
Student "1" -- "*" Submission : makes >
Submission "1" *-- "1..*" SubmissionFile
Submission "1" *-- "*" Feedback
Submission ..> SubmissionStatus

Student "1" *-- "*" PersonalTask
Student "1" *-- "*" TaskCategory
TaskCategory "0..1" o-- "*" PersonalTask

User "1" *-- "*" Notification : receives >
User "1" -- "*" Announcement : posts >
@enduml
