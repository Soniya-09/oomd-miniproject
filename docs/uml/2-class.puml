@startuml
skinparam classAttributeIconSize 0
abstract class Document <<framework>> {
  +name : str
  +owner : str
  +creation : datetime
  +modified : datetime
  +insert()
  +save()
  +delete()
  +validate()
}
class User <<Frappe core>> {
  +email : str
  +first_name : str
  +full_name : str
  +user_type : str
  +enabled : bool
}
class NovaTask {
  +title : str
  +priority : Priority = medium
  +duration_min : int = 45
  +fixed_start : datetime
  +deadline : datetime
  +context : str
  +done : bool = false
  +raw : str {readOnly}
  +validate()
}
enum Priority {
  high
  medium
  low
}
class SchedunovaAPI <<module api.py>> {
  +sign_up(email, full_name, password) : dict
  +me() : dict
  +get_csrf_token() : dict
}
class TaskParser <<planned>> {
  -gemini_api_key : str
  +parse(utterance : str) : NovaTask
}
class DayPlanner <<planned>> {
  +build_plan(user : User, day : date) : DayPlan
}
class DayPlan <<planned>> {
  +day : date
}
class TimeBlock <<planned>> {
  +start : datetime
  +end : datetime
}
Document <|-- User
Document <|-- NovaTask
NovaTask --> Priority
User "1" --> "0..*" NovaTask : owns >
SchedunovaAPI ..> User : <<create>>
TaskParser ..> NovaTask : <<create>>
DayPlanner ..> DayPlan : <<create>>
DayPlan "1" *-- "1..*" TimeBlock
TimeBlock "0..*" o-- "1" NovaTask
DayPlan "0..*" --> "1" User : for >
@enduml
