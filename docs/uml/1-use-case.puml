
@startuml 1-use-case
!include _style.iuml
title EduFlow — Use Case Diagram
left to right direction

actor Admin
actor Teacher
actor Student
actor "Scheduler\n(cron job)" as Cron <<system>>

rectangle "EduFlow System" {
  usecase "Log in" as Login
  usecase "Reset password" as Reset
  usecase "Manage profile" as Profile

  usecase "Manage users" as Users
  usecase "Import users (CSV)" as Import
  usecase "Manage classes & subjects" as Classes
  usecase "Enroll students" as Enroll
  usecase "Assign teachers" as AssignT
  usecase "View reports" as Reports

  usecase "Create assignment" as Create
  usecase "Publish assignment" as Publish
  usecase "Review & grade submission" as Grade
  usecase "Return for revision" as Return
  usecase "Post announcement" as Announce

  usecase "View assignments" as View
  usecase "Submit assignment" as Submit
  usecase "Validate file" as Validate
  usecase "Manage personal tasks" as Tasks
  usecase "View calendar" as Calendar
  usecase "View progress dashboard" as Progress

  usecase "Send notification" as Notify
  usecase "Send reminders" as Remind
}

Admin --> Login
Admin --> Users
Admin --> Classes
Admin --> Enroll
Admin --> AssignT
Admin --> Reports
Admin --> Announce

Teacher --> Login
Teacher --> Create
Teacher --> Publish
Teacher --> Grade
Teacher --> Announce
Teacher --> Reports

Student --> Login
Student --> Profile
Student --> View
Student --> Submit
Student --> Tasks
Student --> Calendar
Student --> Progress

Cron --> Remind

Reset .> Login : <<extend>>
Import .> Users : <<extend>>
Return .> Grade : <<extend>>
Submit ..> Validate : <<include>>
Publish ..> Notify : <<include>>
Grade ..> Notify : <<include>>
Announce ..> Notify : <<include>>
Remind ..> Notify : <<include>>
@enduml
