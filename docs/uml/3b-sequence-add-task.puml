@startuml
title Scenario B: Add task from a sentence
autonumber
actor User as U
participant "ScheduNova Web UI" as FE
participant "Frappe server" as FS
participant "TaskParser\n(planned)" as P
participant "Gemini API" as AI
participant "NovaTask" as T
database "MariaDB" as DB
U -> FE : "Gym tomorrow 7am for an hour, high priority"
FE -> FS : POST parse request + X-Frappe-CSRF-Token
FS -> FS : check session and CSRF token
FS -> P : parse(utterance)
P -> AI : prompt + utterance (HTTPS)
AI --> P : JSON task fields
P --> FS : draft field values
FS --> FE : draft task
FE --> U : show fields for review
U -> FE : confirm or correct
FE -> FS : POST /api/resource/Nova Task
FS -> T : insert()
T -> T : validate() duration_min > 0
alt duration not positive
  T --> FE : error "Duration must be a positive number of minutes."
else valid
  T -> DB : INSERT tabNova Task
  FS --> FE : saved task
  FE --> U : task appears in list
end
@enduml
