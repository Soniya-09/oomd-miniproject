@startuml 4-activity
!include _style.iuml
title EduFlow — Activity Diagram: Assignment process

|Teacher|
start
:Create assignment\n(title, class, subject, due date, marks);
:Attach study material (optional);
if (Publish now?) then (yes)
else (no)
  :Save as draft;
  :Publish later;
endif

|System|
:Make assignment visible to class;
:Send notification to students;

|Student|
:Open assignment and read instructions;
:Upload work;

|System|
if (Deadline passed?) then (yes)
  if (Late submission allowed?) then (no)
    :Reject submission;
    stop
  else (yes)
    :Mark as late;
  endif
else (no)
endif
if (File type and size valid?) then (no)
  :Show error;
  |Student|
  :Upload correct file;
  |System|
else (yes)
endif
:Save submission;
:Notify student "Submission received";

|Teacher|
:Review submission;
if (Work acceptable?) then (yes)
  :Give marks and feedback;
  |System|
  :Notify student "Graded";
  |Student|
  :View grade and feedback;
  stop
else (no)
  :Return for revision with comments;
  |Student|
  :Resubmit improved work;
  |Teacher|
  :Grade resubmission;
  stop
endif
@enduml
