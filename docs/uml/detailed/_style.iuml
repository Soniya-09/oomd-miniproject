' Shared look for every EduFlow diagram.
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #1E3A8A
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 11
skinparam ActorBorderColor #1E3A8A
skinparam ActorBackgroundColor #DBEAFE
skinparam UsecaseBorderColor #1E3A8A
skinparam UsecaseBackgroundColor #F1F5FF
skinparam ClassBorderColor #1E3A8A
skinparam ClassBackgroundColor #F8FAFF
skinparam ClassHeaderBackgroundColor #DBEAFE
skinparam StereotypeCBackgroundColor #5EEAD4
skinparam PackageBorderColor #64748B
skinparam PackageBackgroundColor #FFFFFF
skinparam RectangleBorderColor #1E3A8A
skinparam ComponentBorderColor #1E3A8A
skinparam ComponentBackgroundColor #F1F5FF
skinparam NodeBorderColor #1E3A8A
skinparam NodeBackgroundColor #F8FAFF
skinparam DatabaseBorderColor #0D9488
skinparam DatabaseBackgroundColor #CCFBF1
skinparam StateBorderColor #1E3A8A
skinparam StateBackgroundColor #F1F5FF
skinparam ActivityBorderColor #1E3A8A
skinparam ActivityBackgroundColor #F1F5FF
skinparam ActivityDiamondBorderColor #0D9488
skinparam ActivityDiamondBackgroundColor #CCFBF1
skinparam SequenceLifeLineBorderColor #94A3B8
skinparam ParticipantBorderColor #1E3A8A
skinparam ParticipantBackgroundColor #F1F5FF
skinparam SequenceGroupBorderColor #94A3B8
skinparam NoteBackgroundColor #FEF9C3
skinparam NoteBorderColor #CA8A04
skinparam TitleFontSize 18
skinparam TitleFontColor #0F1E4A
