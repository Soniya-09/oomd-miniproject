@startuml 6-component
!include _style.iuml
title EduFlow — Component Diagram

package "Frontend (Browser)" {
  component [Pages\nHTML + Bootstrap] as Pages
  component [App Script\napi calls, forms, tables] as AppJs
  component [Dashboards\nChart.js charts] as Charts
  component [Task & Calendar\nscripts] as TaskJs
}

package "Backend (PHP)" {
  component [Router] as Router
  component [Security\nlogin check, role check, CSRF] as Security
  component [Controllers\nAdmin, Teacher, Student] as Ctrl

  package "Services" {
    component [User & Class\nManagement] as UserSvc
    component [Assignment\nService] as AssignSvc
    component [Submission\nService] as SubSvc
    component [Personal Task\nService] as TaskSvc
    component [Analytics\nService] as Analytics
    component [Notification\nService] as Notif
    component [File\nStorage] as Files
  }

  component [Database Access\n(PDO)] as DBA
}

component [Reminder Job\n(cron)] as Cron
database "MySQL\nDatabase" as DB
folder "Uploaded Files" as Store

interface "JSON API" as API

Pages ..> AppJs
Charts ..> AppJs
TaskJs ..> AppJs
AppJs --> API
API - Router
Router --> Security
Security --> Ctrl

Ctrl --> UserSvc
Ctrl --> AssignSvc
Ctrl --> SubSvc
Ctrl --> TaskSvc
Ctrl --> Analytics

AssignSvc --> Notif
SubSvc --> Notif
SubSvc --> Files
Cron --> Notif

UserSvc --> DBA
AssignSvc --> DBA
SubSvc --> DBA
TaskSvc --> DBA
Analytics --> DBA
Notif --> DBA
DBA --> DB
Files --> Store
@enduml
