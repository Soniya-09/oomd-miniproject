APP_NAME=EduFlow
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduflow
DB_TEST_DATABASE=eduflow_test
DB_USERNAME=eduflow
DB_PASSWORD=

# 7200 s = 2 h idle timeout
SESSION_LIFETIME=7200
# Set to true when served over HTTPS (default: true if APP_URL starts with https://)
#SESSION_SECURE=true

UPLOAD_MAX_MB=20

# log = write mails to storage/logs/mail.log; mail = PHP mail()
MAIL_DRIVER=log
MAIL_FROM=no-reply@eduflow.local
