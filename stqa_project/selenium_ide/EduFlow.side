{
  "id": "6f1d2c1e-3a51-4b0e-9a64-1f2b7f1e0e01",
  "version": "2.0",
  "name": "EduFlow",
  "url": "http://127.0.0.1:8000",
  "tests": [
    {
      "id": "b5a1c0d2-0001-4c1e-8f00-000000000001",
      "name": "Login as student",
      "commands": [
        { "id": "c-0101", "comment": "Open the login page", "command": "open", "target": "/login", "targets": [], "value": "" },
        { "id": "c-0102", "comment": "", "command": "setWindowSize", "target": "1366x900", "targets": [], "value": "" },
        { "id": "c-0103", "comment": "", "command": "click", "target": "id=email", "targets": [["id=email", "id"], ["css=#email", "css:finder"]], "value": "" },
        { "id": "c-0104", "comment": "", "command": "type", "target": "id=email", "targets": [["id=email", "id"]], "value": "priya.student@eduflow.test" },
        { "id": "c-0105", "comment": "", "command": "type", "target": "id=password", "targets": [["id=password", "id"]], "value": "Demo@1234" },
        { "id": "c-0106", "comment": "Submit the form", "command": "click", "target": "css=form button[type=submit]", "targets": [["css=form button[type=submit]", "css:finder"], ["xpath=//button[normalize-space()='Log in']", "xpath:innerText"]], "value": "" },
        { "id": "c-0107", "comment": "", "command": "waitForElementVisible", "target": "css=h1.page-title", "targets": [], "value": "10000" },
        { "id": "c-0108", "comment": "Student lands on the dashboard", "command": "assertText", "target": "css=h1.page-title", "targets": [], "value": "Dashboard" },
        { "id": "c-0109", "comment": "", "command": "waitForElementVisible", "target": "css=#student-stats .stat-card", "targets": [], "value": "10000" },
        { "id": "c-0110", "comment": "", "command": "assertElementPresent", "target": "css=a[href='/student/tasks?status=overdue']", "targets": [], "value": "" }
      ]
    },
    {
      "id": "b5a1c0d2-0002-4c1e-8f00-000000000002",
      "name": "Quick-add a personal task",
      "commands": [
        { "id": "c-0201", "comment": "Log in", "command": "open", "target": "/login", "targets": [], "value": "" },
        { "id": "c-0202", "comment": "", "command": "setWindowSize", "target": "1366x900", "targets": [], "value": "" },
        { "id": "c-0203", "comment": "", "command": "type", "target": "id=email", "targets": [["id=email", "id"]], "value": "priya.student@eduflow.test" },
        { "id": "c-0204", "comment": "", "command": "type", "target": "id=password", "targets": [["id=password", "id"]], "value": "Demo@1234" },
        { "id": "c-0205", "comment": "", "command": "click", "target": "css=form button[type=submit]", "targets": [], "value": "" },
        { "id": "c-0206", "comment": "", "command": "waitForElementVisible", "target": "css=h1.page-title", "targets": [], "value": "10000" },
        { "id": "c-0207", "comment": "Go to Personal Tasks", "command": "click", "target": "linkText=Personal Tasks", "targets": [["linkText=Personal Tasks", "linkText"], ["css=a[href='/student/tasks']", "css:finder"]], "value": "" },
        { "id": "c-0208", "comment": "", "command": "waitForElementVisible", "target": "id=smart-input", "targets": [], "value": "10000" },
        { "id": "c-0209", "comment": "Type a natural-language task", "command": "type", "target": "id=smart-input", "targets": [["id=smart-input", "id"]], "value": "Read chapter 5 tomorrow 7pm" },
        { "id": "c-0210", "comment": "", "command": "click", "target": "css=#smart-add button[type=submit]", "targets": [["css=#smart-add button[type=submit]", "css:finder"]], "value": "" },
        { "id": "c-0211", "comment": "Success toast", "command": "waitForElementVisible", "target": "css=#toasts .toast-body", "targets": [], "value": "10000" },
        { "id": "c-0212", "comment": "", "command": "assertText", "target": "css=#toasts .toast-body", "targets": [], "value": "Added \"Read chapter 5\"." },
        { "id": "c-0213", "comment": "Task appears in the list", "command": "waitForElementPresent", "target": "xpath=//ul[@id='task-list']//a[normalize-space()='Read chapter 5']", "targets": [], "value": "10000" }
      ]
    },
    {
      "id": "b5a1c0d2-0003-4c1e-8f00-000000000003",
      "name": "Logout",
      "commands": [
        { "id": "c-0301", "comment": "Log in", "command": "open", "target": "/login", "targets": [], "value": "" },
        { "id": "c-0302", "comment": "", "command": "setWindowSize", "target": "1366x900", "targets": [], "value": "" },
        { "id": "c-0303", "comment": "", "command": "type", "target": "id=email", "targets": [["id=email", "id"]], "value": "meera.teacher@eduflow.test" },
        { "id": "c-0304", "comment": "", "command": "type", "target": "id=password", "targets": [["id=password", "id"]], "value": "Demo@1234" },
        { "id": "c-0305", "comment": "", "command": "click", "target": "css=form button[type=submit]", "targets": [], "value": "" },
        { "id": "c-0306", "comment": "", "command": "waitForElementVisible", "target": "css=h1.page-title", "targets": [], "value": "10000" },
        { "id": "c-0307", "comment": "Open the profile menu", "command": "click", "target": "css=.btn-profile", "targets": [["css=.btn-profile", "css:finder"]], "value": "" },
        { "id": "c-0308", "comment": "", "command": "waitForElementVisible", "target": "xpath=//button[normalize-space()='Log out']", "targets": [], "value": "10000" },
        { "id": "c-0309", "comment": "", "command": "click", "target": "xpath=//button[normalize-space()='Log out']", "targets": [["xpath=//button[normalize-space()='Log out']", "xpath:innerText"]], "value": "" },
        { "id": "c-0310", "comment": "Back on the login page", "command": "waitForElementVisible", "target": "id=email", "targets": [], "value": "10000" },
        { "id": "c-0311", "comment": "", "command": "assertTitle", "target": "Log in · EduFlow", "targets": [], "value": "" },
        { "id": "c-0312", "comment": "Protected page is no longer reachable", "command": "open", "target": "/teacher", "targets": [], "value": "" },
        { "id": "c-0313", "comment": "", "command": "waitForElementVisible", "target": "id=email", "targets": [], "value": "10000" },
        { "id": "c-0314", "comment": "", "command": "assertElementPresent", "target": "id=password", "targets": [], "value": "" }
      ]
    }
  ],
  "suites": [
    {
      "id": "5c0a9e3b-0000-4a11-9d00-0000000000aa",
      "name": "EduFlow smoke flows",
      "persistSession": false,
      "parallel": false,
      "timeout": 300,
      "tests": [
        "b5a1c0d2-0001-4c1e-8f00-000000000001",
        "b5a1c0d2-0002-4c1e-8f00-000000000002",
        "b5a1c0d2-0003-4c1e-8f00-000000000003"
      ]
    }
  ],
  "urls": ["http://127.0.0.1:8000/"],
  "plugins": []
}
